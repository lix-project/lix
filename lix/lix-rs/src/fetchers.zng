use ::std::string::String as String;

mod crate::fetchers::git {
	type ObjectFormat {
	  #layout_conservative(size=1, align=8);
	  wellknown_traits(Copy);
	  variant Sha1 {}
	  variant Sha256 {}
	}
	type Kind {
		#layout_conservative(size=16, align=8);
		variant Symbolic {}
		variant Object {}
	}
	type LsRemoteRefLine {
		#layout_conservative(size=56, align=8);
		field kind (offset=auto, type=Kind);
		field target (offset=auto, type=String);
		field reference (offset=auto, type=::std::option::Option<String>);

		fn matches_ref_uri(&self, &str) -> bool;
		fn try_from(&str) -> ::std::result::Result<LsRemoteRefLine, String>;
	}

	type ::std::result::Result<LsRemoteRefLine, String> {
		#layout_conservative(size=56, align=8);

		fn ok(self) -> ::std::option::Option<LsRemoteRefLine>;
	}

	type ::std::option::Option<LsRemoteRefLine> {
		#layout_conservative(size=56, align=8);
	}

	type ::std::option::Option<ObjectFormat> {
		#layout_conservative(size=1, align=8);
	}

	fn detect_object_format(&str) -> ::std::option::Option<ObjectFormat>;
}
