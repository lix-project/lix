merge "./ffi_test.zng";
merge "./repl.zng";
merge "./fetchers.zng";
merge "./machines.zng";
merge "./errors.zng";
merge "./futures.zng";
merge "./fs.zng";
merge "./base64.zng";
merge "./base32.zng";

mod crate::ffi {
    use ::std::result::Result as Result;
    use ::std::string::String as String;

    fn from_raw_parts_u8(*const u8, usize) -> &[u8];
    fn to_os_str(*const u8, usize) -> &::std::ffi::OsStr;
    fn get_cancel_signal() -> i32;

    type Error {
        #layout_conservative(size = 16, align = 8);
        #cpp_value "0" "::std::exception_ptr";
    }

    extern "C++" {
        impl Error {
            safe fn to_string(&self) -> String;
        }
    }

    type Result<(), Error> {
        #layout_conservative(size = 16, align = 8);
    }

    type Box<dyn Fn() -> Result<(), Error>> {
        #layout_conservative(size = 16, align = 8);
    }
}

mod crate::log::ffi {
    fn set_verbosity(i32);

    extern "C++" {
        safe fn log_message(i32, &str);
    }
}

mod crate::embeds {
    fn buildenv_nix() -> &str;
    fn unpack_channel_nix() -> &str;
    fn generate_manpage_nix() -> &str;
    fn get_env_sh() -> &str;
    fn profiles_md() -> &str;
    fn repl_overlays_nix() -> &str;
    fn derivation_nix() -> &str;
    fn imported_drv_to_derivation_nix() -> &str;
    fn fetchurl_nix() -> &str;
}
